{
  "name": "bakaal-real-estate-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/test-integration.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "user:create-admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register.mjs scripts/create-admin.mts",
    "postinstall": "prisma generate",
    "test:smoke": "node scripts/test-smoke.mjs",
    "test:workflow": "node scripts/test-workflow.mjs",
    "test:server": "node scripts/test-server.mjs",
    "predev": "node scripts/check-port.mjs",
    "prestart": "node scripts/check-port.mjs",
    "dev:restart": "node scripts/check-port.mjs --stop-own && next dev -p 3001",
    "serve": "node scripts/check-port.mjs --stop-own && next build && next start -p 3001",
    "db:check": "node scripts/check-integrity.mjs",
    "db:neon:check": "node scripts/neon.mjs check",
    "db:neon:status": "node scripts/neon.mjs status",
    "db:neon:deploy": "node scripts/neon.mjs deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "1.52.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
