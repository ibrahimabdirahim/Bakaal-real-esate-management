# Bakaal Real Estate Management System
# TEMPLATE ONLY — NEVER PUT REAL PASSWORDS, TOKENS, OR SECRETS HERE.
# Copy this file to .env and replace the placeholders with local values.
# This file does not start or configure a database.

# Development database (used by the app and migrations)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# Separate test database; its name MUST end in "_test" (tests refuse to run otherwise)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_test"

# Empty scratch database Prisma uses to check migrations during development
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_shadow"

# --- Production (Neon) — NOT in this file and NOT in .env ---------------------------------------
# On the hosting platform, set these as encrypted environment variables (never in a committed file):
#   DATABASE_URL         Neon POOLED connection string (host contains "-pooler"), ?sslmode=verify-full
#   DIRECT_DATABASE_URL  Neon DIRECT connection string (no "-pooler"), used only by `prisma migrate deploy`
# For the checks on this computer, put the same two strings in a separate, git-ignored `.env.neon` as
# NEON_DATABASE_URL and NEON_DIRECT_URL, then run `npm run db:neon:check` (read-only). See README.

# --- Uploaded documents -------------------------------------------------------------------------
# local (default): a folder on this computer (storage/), or DOCUMENT_STORAGE_DIR if set.
# s3: a PRIVATE S3-compatible bucket (production: Cloudflare R2). Set these on Render, never here:
#   DOCUMENT_STORAGE=s3
#   S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
#   S3_BUCKET="bakaal-documents"
#   S3_ACCESS_KEY_ID="..."            (an R2 API token limited to this bucket: Object Read & Write)
#   S3_SECRET_ACCESS_KEY="..."
#   S3_REGION="auto"
DOCUMENT_STORAGE="local"
# DOCUMENT_MAX_MB="10"

# --- Error alerts (optional) --------------------------------------------------------------------
# Every logged error is also POSTed as JSON to this URL (e.g. a Slack or monitoring webhook).
# ERROR_ALERT_WEBHOOK_URL="https://..."
